# Supabase连接配置
# 从Supabase项目的Settings → Database获取

# KMLog API配置
# 公网部署时建议设置长随机token，并通过Nginx Basic Auth再挡一层
SEARCH_API_TOKEN=change-me
# Optional dedicated token for mother Markdown preview/apply writes.
# Falls back to SEARCH_API_TOKEN when unset.
KMLOG_MOTHER_WRITE_TOKEN=change-me-write-token
# Directory containing memory_system.json, Expansion_Pack_v2.json, and Recent_Updates.json.
KMLOG_WORLDBOOK_DIR=C:\path\to\chat-proxy\world_book
# Optional dedicated token for World Book preview/apply/rebuild writes.
KMLOG_WORLDBOOK_WRITE_TOKEN=change-me-worldbook-write-token
KMLOG_WORLDBOOK_SOURCES=memory_system.json,Expansion_Pack_v2.json,Recent_Updates.json
KMLOG_WORLDBOOK_UPDATE_FILE=Recent_Updates.json
KMLOG_WORLDBOOK_MERGED_FILE=World_Book_Merged.json
KMLOG_SEARCH_BACKEND=sqlite
KMLOG_SQLITE_DB=chat_data/chat_search.db
KMLOG_DISABLE_DOCS=1
KMLOG_BASE_URL=https://example.com/kmlog
KMLOG_API_KEY=change-me

# 方式1：使用完整连接字符串（推荐）
DATABASE_URL=postgresql://postgres:+@db.zmyejaapqzcouwzcszii.supabase.co:5432/postgres

# 或者用components（可选）
# DB_HOST=aws-0-us-west-2.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.your-project-id
# DB_PASSWORD=your-password
